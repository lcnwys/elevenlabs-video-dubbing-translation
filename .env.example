# 复制为 .env，填入真实 ElevenLabs API Key 后开启真实模式
ELEVENLABS_API_KEY=
DEMO_MODE=false
# 仅本地测试：设置 DEMO_MODE=true，生成提示音和占位字幕，不请求 ElevenLabs
MAX_UPLOAD_MB=200
MAX_DURATION_SEC=600
POLL_SECONDS=5
POLL_TIMEOUT_SEC=1800
# 当前文档签名下载地址属于 Google Cloud Storage。若官方变更域名，核实后添加。
ALLOWED_OUTPUT_HOSTS=storage.googleapis.com
